# KeePass 数据库（含真实密钥，禁止提交）
keepassxc/vaults/
keepassxc/installer/
*.kdbx
*.kdbx.lock
*.keyx
*.key
MASTER_PASSWORD.txt

# 应用数据（含真实密钥，通过 Syncthing 同步，禁止提交）
app/data/

# 环境与密钥
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 系统
Thumbs.db
Desktop.ini
.DS_Store

# 用量缓存（临时数据）
app/data/usage_cache.json*

# Syncthing 冲突残留（含真实密钥，永不提交）
app/data/*.sync-conflict-*.json


# Rust
src-tauri/target/
src-tauri/gen/

# 构建产物（portable exe 拷出仓库根时防止误提交）
/account-hub.exe
/release/

# 会话内部文件（截图等，不属于应用）
/.hermes/
